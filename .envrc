#!/usr/bin/env bash
# direnv config for the MESH|Lab website dev shell.
# Run `direnv allow` once after cloning.

watch_file manifest.scm

# Pull dev-shell binaries (hugo, node, go, git, ...) into PATH without
# spawning a subshell, so the parent env's TLS / proxy vars (GIT_SSL_CAINFO,
# SSL_CERT_FILE, CURL_CA_BUNDLE) stay available to hugo / go / git.
eval "$(guix shell --search-paths --manifest=manifest.scm)"

# Hugo's security.exec.osEnv allowlist strips CA-bundle env vars from
# subprocesses by default, which breaks `hugo mod get` on Guix (where git
# has no compile-time CA path). Extend the allowlist so GIT_SSL_CAINFO &
# friends reach git through hugo -> go -> git.
export HUGO_SECURITY_EXEC_OSENV='^(GIT_SSL_CAINFO|SSL_CERT_FILE|SSL_CERT_DIR|CURL_CA_BUNDLE|HOME|PATH|TMP|TEMP|TERM|GO\w+|XDG_\w+|HTTPS?_PROXY|NO_PROXY)$'
